@using CleanArchitecture.Application.Common.Interfaces;
@using CleanArchitecture.Infrastructure.Identity
@using CleanArchitecture.Application.PagesDto
@using Microsoft.AspNetCore.Identity
@model ProfilePageDto
@inject IIdentityService IdentityService
@inject ICurrentUserService CurrentUser
@inject SignInManager<ApplicationUser> SignInManager
<!doctype html>
<html lang="fa" dir="rtl">
<head>
	<meta charset="utf-8">
	<meta content="width=device-width, initial-scale=1.0" name="viewport">

	<title>شرکت آنالیزی نانو مواد صبا</title>
	<meta content="" name="description">
	<meta content="" name="keywords">

	<!-- Favicons -->
	<link href="../favicon.png" rel="icon">
	<link href=" ../apple-touch-icon.png" rel="apple-touch-icon">

	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600;1,700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Raleway:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
		  rel="stylesheet">

	<!-- Vendor CSS Files -->
	<link href="../vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<link href="../vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
	@* <link href="../vendor/aos/aos.css" rel="stylesheet"> *@
	<link href="../vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
	<link href="../vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

	<!-- Template Main CSS File -->
	<link href="../css/main.css" rel="stylesheet">
	<link href="../css/PinCode.css" rel="stylesheet">
	<script type="text/javascript" src="../js/pincode.js"></script>
	<script src="/bootstrap/5/js/bootstrap.bundle.min.js"></script>

	<style>
		.bg-gradient-success {
			background: linear-gradient(135deg, #28a745 0%, #218838 100%);
		}

		.bg-gradient-warning {
			background: linear-gradient(135deg, #ffc107 0%, #ffb100 100%);
		}

		.card-body {
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

			.card-body:hover {
				transform: translateY(-5px);
				box-shadow: 0 8px 20px rgba(0,0,0,0.15);
			}
	</style>
</head>

<body>
	<section id="contact" class="contact">
		<div class="container d-flex flex-column align-items-center justify-content-center" data-aos="fade-up">

			<div class="row gx-lg-0 gy-2 col-md-12 mx-3">
				<div class=" col-md-3 mx-1">
					<div class="card d-flex align-items-start  ">
						<div class="card-body">
							<ul style="padding:0" class="d-flex  list-group list-group-flush">
								<li class="list-group-item">
									<button class="dropdown-item align-items-start justify-content-start  d-flex"
											type="button"
											onclick="window.open('@Url.ActionLink("Index", "Order", new { })')">
										<i class="bi bi bi-bag-heart  mx-2"></i>
										سفارشات
									</button>
								</li>

								@if (CurrentUser.IsInRole("Admin") || CurrentUser.IsInRole("SuperAdmin"))
								{
									<li class="list-group-item">
										<a class="dropdown-item " id="nav-dashboard-tab" data-bs-toggle="tab" href="#nav-dashboard"
										   role="tab" aria-controls="nav-dashboard">
											<i class="bi bi-speedometer2 mx-2"></i>
											داشبورد
										</a>
									</li>

									<li class="list-group-item">
										<a class="dropdown-item " id="nav-price-list-tab" data-bs-toggle="tab" href="#nav-price-list"
										   role="tab" aria-controls="nav-price-list">
											<i class="bi bi-cash-coin mx-2"></i>
											لیست قیمت ها
										</a>
									</li>

								}
								<li class="list-group-item">
									<a class="dropdown-item " id="nav-profile-tab" data-bs-toggle="tab" href="#nav-profile"
									   role="tab" aria-controls="nav-profile">
										<i class="bi bi-person-fill  mx-2"></i>
										ویرایش پروفایل
									</a>
								</li>
								<li class="list-group-item">
									<a class="dropdown-item" id="nav-compaint-tab" data-bs-toggle="tab" href="#nav-compaint"
									   role="tab" aria-controls="nav-compaint">
										<i class="bi bi-file-earmark-text mx-2"> </i>
										ثبت شکایات
									</a>
								</li>
								<li class="list-group-item">
									<a class="dropdown-item" id="nav-recommandation-tab" data-bs-toggle="tab"
									   href="#nav-recommandation" role="tab" aria-controls="nav-recommandation">
										<i class="bi bi-file-earmark-text mx-2"> </i>
										ثبت انتقادات و پیشنهادات
									</a>
								</li>
								<li class="list-group-item">
									<button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex"
											type="button"
											onclick="window.open('@Url.ActionLink("Logout", "Home", new { })')">
										<i class="bi bi-box-arrow-in-right  mx-2"> </i>
										خروج از حساب کاربری
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
				<div class="col-md-6 mx-1">
					<nav>

					</nav>
					<div class="tab-content info-item" id="nav-tabContent">
						<div class="card tab-pane fade show active" id="nav-profile" role="tabpanel"
							 aria-labelledby="nav-profile-tab" style="width:100%">
							<div class="card-header bg-secondary">ویرایش اطلاعات کاربری</div>
							<div class="card-body" style="width:100%">
								@using (Html.BeginForm("EditProfile",
																"Profile", FormMethod.Post, new { }))
								{
									<input type="hidden" name="id" value="@Model.Person.Id" />
									<ul style="padding:0" class="d-flex pull-right list-group list-group-flush">
										<li class="list-group-item">
											<i class="bi bi-person-fill mx-2"></i>
											<label for="firstName" class="form-label">نام</label>
											<input type="text"
												   class="form-control"
												   id="firstName"
												   name="FirstName"
												   asp-for="@Model.Person.FirstName"
												   placeholder="لطفا نام را وارد کنید" required>
										</li>
										<li class="list-group-item">
											<i class="bi bi-person-fill mx-2"></i>
											<label for="lastName" class="form-label">نام خانوادگی</label>
											<input type="text"
												   class="form-control"
												   id="lastName"
												   name="LastName"
												   asp-for="@Model.Person.LastName"
												   placeholder="لطفا نام خانوادگی را وارد کنید" required>
										</li>
										<li class="list-group-item">
											<i class="bi bi-building mx-2"></i>
											<label for="companyName" class="form-label">نام شرکت/دانشگاه/سازمان</label>
											<input type="text"
												   class="form-control"
												   id="companyName"
												   name="CompanyName"
												   asp-for="@Model.Person.CompanyName"
												   placeholder="لطفا نام شرکت/دانشگاه/سازمان را وارد کنید" required>
										</li>
										<li class="list-group-item">
											<i class="bi bi-telephone-fill mx-2"></i>
											<label for="mobileNumber" class="form-label">شماره موبایل</label>
											<input type="text"
												   class="form-control"
												   id="mobileNumber"
												   name="Mobile"
												   asp-for="@Model.Person.Mobile"
												   placeholder="لطفا شماره موبایل را وارد کنید" required>
										</li>
										<li class="list-group-item">
											<i class="bi bi-envelope-fill mx-2"></i>
											<label for="email" class="form-label">ایمیل</label>
											<input type="email"
												   class="form-control"
												   id="email"
												   name="Email"
												   asp-for="@Model.Person.Email"
												   placeholder="لطفا ایمیل را وارد کنید" required>
										</li>
										<li class="list-group-item">
											<i class="bi bi-house-fill mx-2"></i>
											<label for="address" class="form-label">آدرس</label>
											<input type="text"
												   class="form-control"
												   id="address"
												   name="Address"
												   asp-for="@Model.Person.Address"
												   placeholder="لطفا آدرس را وارد کنید" required>
										</li>
										<li class="list-group-item">
											<i class="bi bi-lock-fill mx-2"></i>
											<label for="password" class="form-label">رمز عبور</label>
											<input type="password"
												   class="form-control"
												   id="password"
												   name="Password"
												   placeholder="رمز عبور">
										</li>
									</ul>
									<li class="list-group-item">
										<button type="submit" style="width:100%" class="btn btn-primary">
											<span style="text-align: center; width: 100%;" class="mx-3 align-items-center">ویرایش</span>
										</button>
									</li>
								}
							</div>
						</div>
						<div class="card tab-pane fade" id="nav-dashboard" role="tabpanel"
							 aria-labelledby="nav-dashboard-tab" style="width:100%">
							<div class="card-header bg-secondary">داشبورد</div>
							<div class="card-body" style="width:100%">
								<div class="row g-4">
									<!-- Total Orders -->
									<div class="col-md-6">
										<div class="card border-0 shadow-lg rounded-4 h-100">
											<div class="card-body text-center text-white bg-gradient-success d-flex flex-column justify-content-center align-items-center p-4 rounded-4">
												<h5 class="fw-bold mb-3">سفارشات کل</h5>
												<div class="display-3 fw-bold" style="letter-spacing:2px;">
													@Model.Dashboard.TotalOrdersCount
												</div>
											</div>
										</div>
									</div>

									<!-- Pending Orders -->
									<div class="col-md-6">
										<div class="card border-0 shadow-lg rounded-4 h-100">
											<div class="card-body text-center text-dark bg-gradient-warning d-flex flex-column justify-content-center align-items-center p-4 rounded-4">
												<h5 class="fw-bold mb-3">سفارشات در انتظار بررسی</h5>
												<div class="display-3 fw-bold text-primary" style="letter-spacing:2px;">
													@Model.Dashboard.WaitingOrdersCount
												</div>
											</div>
										</div>
									</div>
								</div>

								<!-- Download Button -->
								<div class="text-center mt-5">
									<a class="btn btn-lg btn-success px-4 py-2 shadow-sm rounded-pill d-inline-flex align-items-center" href="@Url.Action("ExportOrdersToExcel", "Profile")">
										<i class="bi bi-file-earmark-excel-fill me-2"></i>
										دریافت گزارش اکسل
									</a>
								</div>
							</div>
						</div>
						<div class="card tab-pane fade" id="nav-price-list" role="tabpanel"
							 aria-labelledby="nav-price-list-tab" style="width:100%">
							<div class="card-header bg-secondary">لیست قیمت ها</div>
							<div class="card-body" style="width:100%">
								<!-- Price List Table -->
								<table class="table table-bordered table-striped">
									<thead>
										<tr>
											<th>عنوان خدمت</th>
											<th>قیمت (تومان)</th>
											<th>عملیات</th>
										</tr>
									</thead>
									<tbody>

										@for (int i = 0; i < Model.AnalyzePrices.Count; i++)
										{
											@using (Html.BeginForm("UpdatePrice",
																					"Profile", FormMethod.Post, new { }))
											{
												<tr>
													<td>
														@Model.AnalyzePrices[i].Title
														<input type="hidden" name="id" value="@Model.AnalyzePrices[i].Id" />
													</td>
													<td>
														<input type="text"
															   class="form-control"
															   name="price"
															   value="@Model.AnalyzePrices[i].Price.ToString("N0")"
															   min="0"
															   onkeypress="return isNumber(event)"
															   onblur="formatPrice(this)"
															   dir="ltr"
															   style="text-align:left" />
													</td>
													<td>
														<button type="submit" style="width:100%" class="btn btn-primary">
															<span style="text-align: center; width: 100%;" class="mx-3 align-items-center">بروزرسانی</span>
														</button>
													</td>
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
						</div>
						<div class="card tab-pane fade" id="nav-compaint" role="tabpanel" aria-labelledby="nav-compaint-tab"
							 style="width:100%">
							<div class="card-header bg-secondary">ثبت شکایت</div>
							<div class="card-body" style="width:100%">
								<form asp-controller="Profile" asp-action="UploadComplaint" method="post"
									  enctype="multipart/form-data">
									<input type="hidden" name="id" value="@Model.Person.Id" />
									<ul style="padding:0" class="d-flex pull-right list-group list-group-flush">
										<li class="list-group-item">
											<i class="bi bi-person-fill mx-2"></i>
											<label for="trackingCodes" class="form-label">کد رهگیری</label>
											<input type="text"
												   class="form-control"
												   id="trackingCodes"
												   name="TrackingCodes"
												   asp-for="@Model.Complaint.TrackingCodes"
												   placeholder="کد رهگیری را وارد کنید">
										</li>
										<li class="list-group-item">
											<i class="bi bi-file-earmark-text mx-2"></i>
											<label for="orderDescription" class="form-label">عنوان سفارش</label>
											<input type="text"
												   class="form-control"
												   id="orderDescription"
												   name="OrderDescription"
												   asp-for="@Model.Complaint.OrderDescription"
												   placeholder="توضیحات سفارش را وارد کنید">
										</li>
										<li class="list-group-item">
											<i class="bi bi-image mx-2"></i>
											<label for="imageId" class="form-label">آپلود تصویر</label>
											<input type="file" id="fileInput" class="form-control" name="UploadedFile"
												   required aria-required="true">
										</li>
										<li class="list-group-item">
											<i class="bi bi-chat-left-text-fill mx-2"></i>
											<label for="description" class="form-label">توضیحات</label>
											<textarea class="form-control"
													  id="description"
													  name="Description"
													  asp-for="@Model.Complaint.Description"
													  placeholder="توضیحات را وارد کنید"></textarea>
										</li>
									</ul>
									<li class="list-group-item">
										<button type="submit" style="width:100%" class="btn btn-primary">
											<span style="text-align: center; width: 100%;" class="mx-3 align-items-center">ثبت شکایت</span>
										</button>
									</li>
								</form>
							</div>
						</div>
						<div class="card tab-pane fade" id="nav-recommandation" role="tabpanel"
							 aria-labelledby="nav-recommandation-tab" style="width:100%">
							<div class="card-header bg-secondary">ثبت انتقادات و پیشنهادات</div>
							<div class="card-body" style="width:100%">
								<form asp-controller="Profile" asp-action="UploadRecommendation" method="post">
									<input type="hidden" name="id" value="@Model.Person.Id" />
									<ul style="padding:0" class="d-flex pull-right list-group list-group-flush">
										<li class="list-group-item">
											<i class="bi bi-lightbulb-fill mx-2"></i>
											<label for="recommandation" class="form-label">توضیحات</label>
											<textarea class="form-control"
													  id="recommendation-description"
													  name="recommendation-description"
													  asp-for="@Model.Recommendation.Description"
													  placeholder="انتقاد یا پیشنهاد خود را وارد کنید"></textarea>
										</li>
									</ul>
									<li class="list-group-item">
										<button type="submit" style="width:100%" class="btn btn-primary">
											<span style="text-align: center; width: 100%;" class="mx-3 align-items-center">ثبت</span>
										</button>
									</li>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section id="recent-posts" class="recent-posts sections-bg">
		<div class="container" data-aos="fade-up">

			<div class="section-header">
				<h2>مقالات پیشنهادی</h2>
				<p>
					بخش مقالات، محلی است که مطالبی در زمینه شیمی و علوم مرتبط با آن به صورت مقاله منتشر می‌شود. این بخش
					می‌تواند برای افزایش دانش و آگاهی عمومی در زمینه شیمی، همچنین بهبود روند تحقیقات و توسعه در این حوزه
					مفید باشد.
				</p>
			</div>

			<div class="row gy-4">

				@if (Model?.Articles is { Count: > 0 })
				{
					@foreach (var item in Model?.Articles)
					{
						<div class="col-xl-4 col-md-6">
							<article>

								<div class="post-img d-flex justify-content-center">
									<img src="@item.ImageUrl" class=" img-fluid rounded-4" alt="" />
								</div>

								<p class="post-category">@item.CategoryTitle</p>

								<h2 class="title">
									<a href="blog-details.html">
										@Html.ActionLink(@item.Name, "ArticleById", "Article", new { myParams = item.Id }, null)
									</a>
								</h2>

								<div class="d-flex align-items-center">
									<div class="post-meta">
										<p class="post-author"> @IdentityService.GetUserName(Convert.ToInt64(item.CreatedBy))</p>
										<p class="post-date">
											<time>@item.Created</time>
										</p>
									</div>
								</div>

							</article>
						</div>
					}
				}
			</div><!-- End recent posts list -->

		</div>
	</section><!-- End Recent Blog Posts Section -->
</body>

</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script type="text/javascript">
	function isNumber(evt) {
		evt = (evt) ? evt : window.event;
		var charCode = (evt.which) ? evt.which : evt.keyCode;
		if ((charCode > 31 && charCode < 48) || charCode > 57) {
			return false;
		}
		return true;
	}

	function formatPrice(input) {
		const value = input.value.replace(/,/g, '');
		if (!isNaN(value) && value !== '') {
			input.value = Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
		}
	}

	$(document).ready(function () {
		$('.nav-toggle').click(function () {
			var collapse_content_selector = $(this).attr('href');
			var toggle_switch = $(this);
			$(collapse_content_selector).toggle(function () {
				if ($(this).css('display') == 'none') {
					toggle_switch.html('بیشتر');
				} else {
					toggle_switch.html('کمتر');
				}
			});
		});

	});
</script>