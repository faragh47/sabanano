                                        </div>
                                    </div>
                                    <div class="col-md-5 mx-2">
                                        <div class="form-outline">
                                            <label for="validationDefault05" class="form-label">رمز عبور</label>
                                            <input type="password" class="form-control" oninvalid="this.setCustomValidity('لطفا رمز عبور را وارد کنید')" name="Password" id="Password" required/>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-primary mt-4" type="submit">ورود</button>
                            </form>

                        </div>
                    </div>


                </div>

            </div>

        </div>
    </div>
</section>

</body>

</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script type="text/javascript">
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if ((charCode > 31 && charCode < 48) || charCode > 57) {
            return false;
        }
        return true;
    }
  $(document).ready(function () {
         $("#mobileNumberForm").submit(function (event) {
              // Prevent default submission
              event.preventDefault();
              
              // Validate Mobile Number Field
              let isValid = validateField(
                  "MobileNumber",           
                  "MobileNumberError",      
                  "شماره موبایل",         
                  { required: true, numeric: true, length: 11 } 
              );
      
              // Submit the form if valid
              if (isValid) {
                  this.submit();
              }
          });
       $("#registerForm").submit(function (event) {
          console.log("submit form");
          // Prevent form submission if there are validation errors
          event.preventDefault();
          let isValid = true;
  
          // Validate fields
          isValid &= validateField("CompanyName", "CompanyError", "نام شرکت/دانشگاه/سازمان", { required: true });
          isValid &= validateField("Mobile", "MobileError", "موبایل", { required: true, numeric: true, length: 11 });
          isValid &= validateField("Email", "EmailError", "ایمیل", { required: true, email: true });
          isValid &= validateField("LastName", "LastNameError", "نام خانوادگی", { required: true });
          isValid &= validateField("FirstName", "FirstNameError", "نام", { required: true });
          isValid &= validateField("Password", "PasswordError", "رمز عبور", { required: true });
          isValid &= validateField("Address", "AddressError", "آدرس", { required: true });
          if (isValid) {
              // Form is valid; proceed with submission
              this.submit();
          }
      });
  
      function validateField(fieldId, errorMessageId, fieldName, options) {
          var fieldValue = $("#" + fieldId).val();
          var isFieldValid = true;
  
          // Clear existing error message
          $("#" + errorMessageId).text("");
  
          // Check if required
          if (options.required && !fieldValue) {
              isFieldValid = false;
              $("#" + errorMessageId).text("وارد کردن " + fieldName + " الزامی است");
          }
  
          // Check if numeric
          if (options.numeric && fieldValue && !/^\d+$/.test(fieldValue)) {
              isFieldValid = false;
              $("#" + errorMessageId).text(fieldName + " باید فقط شامل اعداد باشد");
          }
  
          // Check exact length
          if (options.length && fieldValue && fieldValue.length !== options.length) {
              isFieldValid = false;
              $("#" + errorMessageId).text(fieldName + " باید دقیقا " + options.length + " رقم باشد");
          }
  
          // Check minimum length
          if (options.minLength && fieldValue && fieldValue.length < options.minLength) {
              isFieldValid = false;
              $("#" + errorMessageId).text(fieldName + " باید حداقل " + options.minLength + " کاراکتر باشد");
          }
  
          return isFieldValid;
      }
  });
</script>