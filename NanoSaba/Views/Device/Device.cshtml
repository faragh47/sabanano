                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-auto ">
                        <label class="form-check-label text-secondary">مدل:</label>
                    </div>
                    <div class="col-auto">
                        @Model.AnalyzerDevice.Model
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-auto">
