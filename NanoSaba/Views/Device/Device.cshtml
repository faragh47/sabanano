                    </div>
                    <div class="col-auto">
                        @Model.AnalyzerDevice.Name
                    </div>
                </div>
                <div class="row  mt-2">
                    <div class="col-auto">
                        <label class="form-check-label text-secondary">اسم کامل:</label>
                    </div>
