                </li>   
                <li class="list-group-item">
                    @*          <button type="button" style="width:100%" class="btn btn-primary">
                                    <i class="bi bi-cloud-download-fill d-flex align-items-center "><span style="text-align: center; width: 100%; " class="mx-3 align-items-center">دانلود فرم آنالیز</span></i>
                                    @*<a href="@Model?.AnalyzerDevice?.RegisterForm" target="_blank" class="stretched-link" />*@
                    @*<a href="@Model.AnalyzerDevice.RegisterForm" class="stretched-link" />
                                    </button>
                                    *@
                    <a style="width:100%" class="mx-5" href="@Model.AnalyzerDevice.RegisterForm" target="_blank" class="stretched-link">دانلود فرم آنالیز</a>
                </li>
            </ul>
        </div>
    </div>
</div>

</div>


</div>
</section>

@if (Model.AnalyzerDevice.Responses is { Count: > 0 })
{
    <section id="recent-posts" class="recent-posts sections-bg mt-5">
        <div class="container" data-aos="fade-up">

            <div class="section-header">
                <h2>فرمت پاسخگویی</h2>
            </div>
            @foreach (var item in Model.AnalyzerDevice.Responses.Where(x => x.ImageId is null))
            {
                <p>
                    <b> &#9642; @item.Description</b>
                </p>
            }

            @{
                var FirstresponseWithImage = Model.AnalyzerDevice.Responses.Where(x => x.ImageId is not null).FirstOrDefault();
                if (!string.IsNullOrEmpty(FirstresponseWithImage?.Title))
                {
                    <h3 class="mt-4">@FirstresponseWithImage?.Title</h3>
                }

                <img src="@FirstresponseWithImage?.ImageUrl" class="img-fluid mt-4" alt=""/>
                if (!string.IsNullOrEmpty(FirstresponseWithImage?.Description))
                {
                    <p>
                        <b> &#9642; @FirstresponseWithImage?.Description</b>
                    </p>
                }
            }

            <div class="row">
                <a href="#collapse" class="nav-toggle mt-4">بیشتر</a>
            </div>


            <div id="collapse" style="display:none">
                @{
                    var listOfItems = Model.AnalyzerDevice.Responses.Where(x => x.ImageId is not null).ToList();
                    @for (int i = 1; i < listOfItems.Count(); i++)
                    {
                        if (!string.IsNullOrEmpty(listOfItems[i].Title))
                        {
                            <h3 class="mt-4">@listOfItems[i].Title</h3>
                        }

                        <img src="@listOfItems[i].ImageUrl" class="img-fluid mt-4" alt=""/>

                        if (!string.IsNullOrEmpty(listOfItems[i].Description))
                        {
                            <p> &#9642; @listOfItems[i].Description</p>
                        }
                    }
                }
            </div>
        </div>

    </section>

    <!-- End Recent Blog Posts Section -->
}


<section id="recent-posts" class="recent-posts sections-bg">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>مقالات پیشنهادی</h2>
            <p>بخش مقالات، محلی است که مطالبی در زمینه شیمی و علوم مرتبط با آن به صورت مقاله منتشر می‌شود. این بخش می‌تواند برای افزایش دانش و آگاهی عمومی در زمینه شیمی، همچنین بهبود روند تحقیقات و توسعه در این حوزه مفید باشد.</p>
        </div>

        <div class="row gy-4">

            @if (Model?.Articles is { Count: > 0 })
            {
                @foreach (var item in Model?.Articles)
                {
                    <div class="col-xl-4 col-md-6">
                        <article>

                            <div class="post-img d-flex justify-content-center">
                                <img src="@item.ImageUrl" class=" img-fluid rounded-4" alt=""/>
                            </div>

                            <p class="post-category">@item.CategoryTitle</p>

                            <h2 class="title">
                                <a href="blog-details.html">
                                    @Html.ActionLink(@item.Name, "ArticleById", "Article", new { myParams = item.Id }, null)
                                </a>
                            </h2>

                            <div class="d-flex align-items-center">
                                <div class="post-meta">
                                    <p class="post-author"> @IdentityService.GetUserName(Convert.ToInt64(item.CreatedBy))</p>
                                    <p class="post-date">
                                        <time>@item.Created</time>
                                    </p>
                                </div>
                            </div>

                        </article>
                    </div>
                }
            }
        </div><!-- End recent posts list -->

    </div>
</section><!-- End Recent Blog Posts Section -->
</body>

</html>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script type="text/javascript">
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if ((charCode > 31 && charCode < 48) || charCode > 57) {
            return false;
        }
        return true;
    }


    $(document).ready(function () {
        $('.nav-toggle').click(function () {
            var collapse_content_selector = $(this).attr('href');
            var toggle_switch = $(this);
            $(collapse_content_selector).toggle(function () {
                if ($(this).css('display') == 'none') {
                    toggle_switch.html('بیشتر');
                } else {
                    toggle_switch.html('کمتر');
                }
            });
        });

    });
</script>