                    </div>
                    <div class="col-auto">
                        @Model.AnalyzerDevice.Sample
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="nav-attribute" role="tabpanel" aria-labelledby="nav-attribute-tab">
                @* <div class="row mt-2">
                                <div class="col-auto">
                                <label class="form-check-label text-secondary">شرایط نگه داری:</label>
                                </div>
                                <div class="col-auto">
                                @Model.AnalyzerDevice.MaintenanceCondition
                                </div>
                                </div>*@
                <div class="row mt-2">
                    <div class="col-auto">
                        <label class="form-check-label text-secondary">توضیحات آماده سازی:</label>
                    </div>
                    <div class="col-auto">
                        @Model.AnalyzerDevice.DescriptionForReadyAnalyze
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-auto">
