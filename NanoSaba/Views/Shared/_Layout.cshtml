                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenu2">
                    <li>
                        <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                onclick="window.open('@Url.ActionLink("Index", "Profile", new { })')">
                            <i class="bi bi-person  mx-2"> </i>
                            @CurrentUser.FullName
                        </button>
                    </li>
                    @* @if (CurrentUser.UserName is not null && *@
                    @*      (CurrentUser.UserName.Equals("09124798930") || *@
                    @*       CurrentUser.UserName.Equals("09129366624") || *@
                    @*       CurrentUser.UserName.Equals("09215628768") || *@
                    @*       CurrentUser.UserName.Equals("09108343551"))) *@
                    @* { *@
                        <li>
                            <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                    onclick="window.open('@Url.ActionLink("Index", "OrderCart", new { })')">
                                <i class="bi bi-cart3  mx-2"></i>
                                سبد خرید
                                @if (Order.InitialExist())
                                {
                                    <span class="badge bg-danger mx-2">
                                        @Order.InitialCount()
                                    </span>
                                }
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                    onclick="window.open('@Url.ActionLink("Index", "Order", new { })')">
                                <i class="bi bi bi-bag-heart  mx-2"></i>
                                سفارشات
                            </button>
                        </li>
                    @* } *@
                    <li>
                        <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                onclick="window.open('@Url.ActionLink("Logout", "Home", new { })')">
                            <i class="bi bi-box-arrow-in-right  mx-2"> </i>
                            خروج از حساب کاربری
                        </button>
                    </li>
                </ul>
            </div>
        }
    </div>
</header><!-- End Header -->
<div>
    <main role="main" class="pb-3">
        @RenderBody()
        @if (@Model?.IsSuccess is false)
        {
            <div class="alert alert-danger mx-4 mt-2 col-md-3 d-flex justify-content-start" id="selectCodeNotificationArea" role="alert">
                <a type="button" onclick="CloseAlert()" class="close mx-4" data-hide="alert">&times;</a>
                @Model?.Message
            </div>
        }
    </main>

</div>
