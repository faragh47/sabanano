        <div class="contact-info d-flex flex-column flex-sm-row align-items-center text-center text-md-start">
            <div class="d-flex align-items-center ms-sm-4 mb-2 mb-sm-0">
                <i class="bi bi-phone d-flex align-items-center me-2"></i>
                <span> ۰۹۱۲۲۱۹۹۲۳۲</span>
                <span class="d-block">
                    <span>نانو مواد صبا</span> NMS
                </span>
            </div>
        </div>
    </div>
</section><!-- End Top Bar -->

<header id="header" class="header d-flex align-items-center">

    <div class="container-fluid container-xl d-flex align-items-center justify-content-between">
        <a class="navbar-brand" href="#" style="display: flex; align-items: center;">
            <img src="../img/logo.png" style="display: inline-block;"/>
            <!-- Visible only on desktop (md and above) -->
            <h4 class="text-white ms-2 d-none d-md-block">
                <span class="d-inline">آزمایشگاه</span>
                <span class="d-inline">نانو مواد صبا</span>
                <span class="d-inline">.</span>
            </h4>
            <!-- Visible only on mobile (less than md) -->
            <h4 class="text-white ms-2 d-md-none">
                <span class="d-inline">نانو مواد صبا</span>
            </h4>
        </a>
        <nav id="navbar" class="navbar">
            <ul>
                <li>
                    <a href="../Home/#hero">نانو مواد صبا</a>
                </li>
                <li>
                    <a href="../Home/#portfolio">خدمات آنالیز</a>
                </li>
                <li>
                    <a href="../Home/#services">نحوه ی ثبت سفارش</a>
                </li>
                <li>
                    <a href="../Home/#recent-posts">مقالات آنالیز</a>
