        @if (!SignInManager.IsSignedIn(User))
        {
            <button type="button" class="btn btn-outline-light d-flex align-items-center justify-content-center responsive-btn"
                    onclick="location.href='@Url.Action("SignIn", "Home")'">
                <i class="bi bi-person icon-mobile"></i>
                <i class="bi bi-person-sm icon-mobile"></i>
                <span class="mx-2 d-none d-lg-inline">ورود</span>  <!-- Visible from lg screens and up -->
                <span class="mx-2 d-inline d-lg-none">ورود</span>  <!-- Visible on screens smaller than lg -->
            </button>
        }
        else
        {
            <div class="dropdown d-flex align-items-start justify-content-start ml-auto pull-right">
