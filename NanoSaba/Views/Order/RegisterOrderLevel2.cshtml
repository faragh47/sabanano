<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script type="text/javascript">
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if ((charCode > 31 && charCode < 48) || charCode > 57) {
            return false;
        }
        return true;
    }
   document.addEventListener('DOMContentLoaded', function () {
       const hasGrantCheckbox = document.getElementById("HasGrant");
       const hasCompanyCheckbox = document.getElementById("HasCompany");
       const grantCardBody = document.getElementById("grantCardBody");
       const TelNumber = document.getElementById("TelNumber");
       const UniversityName = document.getElementById("UniversityName");
       const NationalCode = document.getElementById("NationalCode");
       const FirstName = document.getElementById("FirstName");
       const LastName = document.getElementById("LastName");
       const companyCardBody = document.getElementById("companyCardBody");
       const CompanyNationalCode = document.getElementById("CompanyNationalCode");
   
       // Toggle grant fields visibility and required attributes
       hasGrantCheckbox.addEventListener('change', function () {
           if (this.checked) {
               grantCardBody.style.display = "block";
               TelNumber.setAttribute('required', 'required');
               UniversityName.setAttribute('required', 'required');
               NationalCode.setAttribute('required', 'required');
               FirstName.setAttribute('required', 'required');
               LastName.setAttribute('required', 'required');
           } else {
               grantCardBody.style.display = "none";
               TelNumber.removeAttribute('required');
               UniversityName.removeAttribute('required');
               NationalCode.removeAttribute('required');
               FirstName.removeAttribute('required');
               LastName.removeAttribute('required');
           }
       });
   
       // Toggle company fields visibility and required attributes
       hasCompanyCheckbox.addEventListener('change', function () {
           if (this.checked) {
               companyCardBody.style.display = "block";
               CompanyNationalCode.setAttribute('required', 'required');
           } else {
               companyCardBody.style.display = "none";
               CompanyNationalCode.removeAttribute('required');
           }
       });
   });
   
   // jQuery for toggling and form validation
   $(document).ready(function () {
       // Toggle collapse content for navigation
       $('.nav-toggle').click(function () {
           var collapse_content_selector = $(this).attr('href');
           var toggle_switch = $(this);
           $(collapse_content_selector).toggle(function () {
               toggle_switch.html($(this).css('display') === 'none' ? 'بیشتر' : 'کمتر');
           });
       });
   
       // Form validation
       $("form").submit(function (event) {
           let isValid = true;
           // Validate fields with their specific rules
           isValid &= validateField("CompanyNationalCode", "CompanyNationalCodeError", "کد ملی شرکت", { required: $("#HasCompany").is(":checked"), numeric: true, length: 10 });
           isValid &= validateField("TelNumber", "TelNumberError", "شماره تلفن", { required: $("#HasGrant").is(":checked"), numeric: true, length: 11 });
           isValid &= validateField("UniversityName", "UniversityNameError", "نام دانشگاه", { required: $("#HasGrant").is(":checked") });
           isValid &= validateField("NationalCode", "NationalCodeError", "کد ملی", { required: $("#HasGrant").is(":checked"), numeric: true, length: 10 });
           isValid &= validateField("LastName", "LastNameError", "نام خانوادگی", { required: $("#HasGrant").is(":checked") });
           isValid &= validateField("FirstName", "FirstNameError", "نام", { required: $("#HasGrant").is(":checked") });
   
       });
   
       function validateField(fieldId, errorMessageId, fieldName, options) {
           var fieldValue = $("#" + fieldId).val();
           var isFieldValid = true;
   
           // Clear previous error messages
           $("#" + errorMessageId).text("");
   
           // Required validation
           if (options.required && (!fieldValue || fieldValue.trim() === "")) {
               isFieldValid = false;
               $("#" + errorMessageId).text("وارد کردن " + fieldName + " الزامی است");
           }
   
           // Numeric validation
           if (options.numeric && fieldValue && !/^\d+$/.test(fieldValue)) {
               isFieldValid = false;
               $("#" + errorMessageId).text(fieldName + " باید فقط شامل اعداد باشد");
           }
   
           // Exact length validation
           if (options.length && fieldValue && fieldValue.length !== options.length) {
               isFieldValid = false;
               $("#" + errorMessageId).text(fieldName + " باید دقیقا " + options.length + " رقم باشد");
           }
   
           // Styling invalid fields
           if (!isFieldValid) {
               $("#" + fieldId).addClass("is-invalid");
           } else {
               $("#" + fieldId).removeClass("is-invalid");
           }
   
           return isFieldValid;
       }
    });
</script>