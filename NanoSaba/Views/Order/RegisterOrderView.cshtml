    <style>
        body {
            direction: rtl;
        }
        /* Custom style for button with no background */
        .btn-no-background {
            background: none;
            border: none;
            padding: 0;
            color: inherit;
            cursor: pointer;
        }
        .btn-no-background:hover {
            color: #007bff; /* Optional: color change on hover */
        }
        .form-check {
            text-align: right;
            position: relative; /* Ensure the checkbox positioning works properly */
        }

        .form-check-input {
            content: "";
            display: inline-block;
            width: 19px;
            height: 19px;
            margin-right: 5px;
            position: absolute;
            right: 0;
            top: 3px; /* Adjust if necessary to vertically center */
            background-color: #fff;
            border: 2px solid #d0d0d0;
            border-radius: 4px;
            box-sizing: border-box;
            transition: all .25s;
            color: #fff;
            text-align: center;
            line-height: 15px;
        }
        .form-check-label {
            margin-right: 30px; /* Adjust as needed for spacing between checkbox and label */
            padding-left: 25px; /* Additional padding for better spacing */
            white-space: nowrap; /* Prevent label text from wrapping to a new line */
        }
    </style>
