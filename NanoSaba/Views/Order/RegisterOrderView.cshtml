<script type="text/javascript">
                       function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if ((charCode > 31 && charCode < 48) || charCode > 57)
        {
            return false;
        }

        return true;
    }
    
                       function submitForm(action, id = null) {
                           var form = document.getElementById('myForm');
                           console.log(id);
                           console.log(form);
                           if (id) {
                               document.getElementById('analyzeId').value = id;
                           }
                       }

                       function checkedHasNoConditon(checkbox) {
                           // Get the other checkboxes
                           var isSensitiveToLight = document.getElementById("isSensitiveToLight");
                           var isSensitiveToHumidity = document.getElementById("isSensitiveToHumidity");
                           if (checkbox.checked) {
                               isSensitiveToLight.checked = false;
                               isSensitiveToHumidity.checked = false;
                           }
                       }

                       function uncheckHasNoConditon() {
                           var hasNotAnyCondition = document.getElementById("hasNotAnyCondition");
                           if (document.getElementById("isSensitiveToLight").checked
                             ||document.getElementById("isSensitiveToHumidity").checked) {
                               hasNotAnyCondition.checked = false;
                           }
                       }
                       function checkedHasNoSafety(checkbox) {
                           // List of safety-related checkboxes
                           var safetyCheckboxes = [
                               document.getElementById("isPoisonous"),
                               document.getElementById("isEscapable"),
                               document.getElementById("isFlammable"),
                               document.getElementById("isBadForBreathing"),
                               document.getElementById("isAdsorbBySkin"),
                               document.getElementById("isNanoSize"),
                               document.getElementById("isSickness"),
                               document.getElementById("isExplosive")
                           ];

                           // If "HasNoSafety" is checked, uncheck all other safety checkboxes
                           if (checkbox.checked) {
                               safetyCheckboxes.forEach(function (checkbox) {
                                   checkbox.checked = false;
                               });
                           }
                       }

                       // When any safety-related checkbox is checked, uncheck "HasNoSafety"
                       function uncheckHasNoSafety() {
                           var hasNoSafety = document.getElementById("hasNoSafety");

                           var safetyCheckboxes = [
                               document.getElementById("isPoisonous"),
                               document.getElementById("isEscapable"),
                               document.getElementById("isFlammable"),
                               document.getElementById("isBadForBreathing"),
                               document.getElementById("isAdsorbBySkin"),
                               document.getElementById("isNanoSize"),
                               document.getElementById("isSickness"),
                               document.getElementById("isExplosive")
                           ];

                           // If any safety-related checkbox is checked, uncheck "HasNoSafety"
                           if (safetyCheckboxes.some(function (checkbox) { return checkbox.checked; })) {
                               hasNoSafety.checked = false;
                           }
                       }
    $(document).ready(function() {
        $('.nav-toggle').click(function() {
            var collapse_content_selector = $(this).attr('href');
            var toggle_switch = $(this);
                $(collapse_content_selector).toggle(function() {
                if ($(this).css('display') == 'none') {
                    toggle_switch.html('بیشتر');
                } else {
                    toggle_switch.html('کمتر');
                }
            });
        });
    });
    </script >