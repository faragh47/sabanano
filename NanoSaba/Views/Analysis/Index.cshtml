@{
    ViewData["Title"] = "خدمات آنالیز";

    // Each card: device code (used in the details link), Persian subtitle, image, analysis form PDF.
    var devices = new[]
    {
        new { Code = "XRF", Subtitle = "آنالیز فلورسانس اشعه ایکس", Image = "/img/XRF.jpg", Form = "XRF.pdf" },
        new { Code = "ICP-MS", Subtitle = "آنالیز طیف سنجی جرمی پلاسمای جفت شده ی القایی", Image = "/img/ICP-MS.jpg", Form = "ICP.pdf" },
        new { Code = "XRD", Subtitle = "آنالیز طیف سنجی پراش پرتو ایکس", Image = "/img/XRD.jpg", Form = "XRD.pdf" },
        new { Code = "ICP-OES", Subtitle = "آنالیز طیف سنجی نشری پلاسمای جفت شده القایی", Image = "/img/ICP-OES.jpg", Form = "ICP.pdf" },
        new { Code = "TEM", Subtitle = "میکروسکوپ الکترونی عبوری", Image = "/img/TEM.png", Form = "TEM.pdf" },
        new { Code = "SEM", Subtitle = "میکروسکوپ الکترونی روبشی", Image = "/img/SEM.png", Form = "SEM.pdf" },
        new { Code = "EDX", Subtitle = "طیف سنجی پراش انرژی پرتو ایکس", Image = "/img/EDX.png", Form = "EDX_Mapping.pdf" },
        new { Code = "Mapping", Subtitle = "نقشه برداری عنصری", Image = "/img/Mapping.png", Form = "EDX_Mapping.pdf" },
        new { Code = "FTIR", Subtitle = "طیف سنجی مادون قرمز تبدیل فوریه", Image = "/img/FTIR.png", Form = "FTIR.pdf" },
        new { Code = "BET", Subtitle = "سنجش سطح ویژه مواد متخلخل", Image = "/img/BET.png", Form = "BET.pdf" },
        new { Code = "UV-Vis", Subtitle = "طیف سنجی فرابنفش - مرئی", Image = "/img/UV-VIS.png", Form = "UV-Vis.pdf" },
        new { Code = "GC-MS", Subtitle = "کروماتوگرافی گازی - طیف سنجی جرمی", Image = "/img/GC-MS.png", Form = "GC-MS.pdf" },
        new { Code = "AAS", Subtitle = "طیف سنجی جذب اتمی", Image = "/img/AAS.png", Form = "AAS.pdf" },
        new { Code = "AFM", Subtitle = "میکروسکوپ نیروی اتمی", Image = "/img/AFM.png", Form = "AFM.pdf" },
        new { Code = "ContactAngle", Subtitle = "اندازه گیری زاویه تماس", Image = "/img/ContactAngle.png", Form = "Contact angle.pdf" },
        new { Code = "TGA", Subtitle = "آنالیز حرارتی وزن سنجی", Image = "/img/TA.png", Form = "TGA-DSC.pdf" },
        new { Code = "FireAssay", Subtitle = "تعیین غلظت فلزات گرانبها", Image = "/img/FireAssay.png", Form = "FireAssay.pdf" },
    };
}

<link href="~/css/nms-analysis.css" rel="stylesheet" asp-append-version="true">

<section class="nms-analysis">
    <div class="container-xl">

        <header class="nms-analysis__intro">
            <h1 class="nms-analysis__title">خدمات آنالیز</h1>
            <p class="nms-analysis__text">
                آزمایشگاه تحقیقاتی شناسایی نانو مواد صبا با کادری مجرب از کارشناسان و مهندسین حوزه آنالیز و نانوتکنولوژی، آماده ی ارائه
                خدمات آنالیزی اعم از سنجش سطح مواد متخلخل( آنالیز BET) و آنالیز شناسایی ترکیبات آلی به کمک آنالیز FTIR و آنالیز GC-MS
                و همچنین آنالیز های مواد معدنی چون آنالیز ICP-MS، آنالیز ICP-OES، آنالیز XRF، آنالیز XRD و تعیین غلظت فلزات گرانبها به
                کمک Fire Assay به جامعه علمی کشور، دانشگاه ها، کارخانجات، شرکت های دانش بنیان و شرکت های اکتشاف و استخراج
                معادن می باشد. همچنین این آزمایشگاه یکی از آزمایشگاه های فعال در حوزه شناسایی مواد مجهول، مشکوک، افزودنی ها، رنگ
                ،پلیمرها ، پوشش وعمده ی مواد تجاری شیمیایی وترکیبات مخلوط مورد استفاده در کارگاه ها و کارخانجات تولیدی و مهندسی
                معکوس به وسیله آنالیز FTIR و جستجوی کتابخانه ای مواد تحت آنالیز به کمک Bio Radو KnowITAll است.
            </p>
        </header>

        <div class="nms-analysis__grid">
            @foreach (var device in devices)
            {
                var detailsUrl = Url.Action("DeviceById", "Device", new { myParams = device.Code });

                <article class="nms-service-card">
                    <a class="nms-service-card__media" href="@detailsUrl">
                        <img src="@device.Image" alt="دستگاه @device.Code" loading="lazy">
                    </a>
                    <div class="nms-service-card__body">
                        <h2 class="nms-service-card__title">
                            <a href="@detailsUrl">آنالیز <span dir="ltr">@device.Code</span></a>
                        </h2>
                        <p class="nms-service-card__subtitle">@device.Subtitle</p>
                        <div class="nms-service-card__footer">
                            <a class="nms-service-card__more" href="@detailsUrl">
                                مشاهده جزئیات
                                <i class="bi bi-arrow-right"></i>
                            </a>
                            <a class="nms-service-card__form" href="http://www.nanomavadsaba.com/files/@device.Form" target="_blank"
                               title="دانلود فرم آنالیز" aria-label="دانلود فرم آنالیز @device.Code">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

    </div>
</section>
